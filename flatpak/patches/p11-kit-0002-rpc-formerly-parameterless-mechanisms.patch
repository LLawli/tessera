From 865a6b488245c36beb09bff042a016ae323ee1e0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Rikard=20S=C3=B6derstr=C3=B6m?=
 <Rikard.Soderstrom@permobil.com>
Date: Wed, 11 Nov 2026 16:40:45 +0100
Subject: [PATCH 2/2] rpc: Keep formerly parameterless mechanisms parameterless
 in v1 encoding
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The protocol version 0 and 1 mechanism encoding takes the mechanisms
without parameters, and the serializer for each mechanism, from the same
lists as the current encoding. Commit 0efdd49 ("Add missing RPC
serializers") moved CKM_SHA512_T, CKM_SHA512_T_HMAC, CKM_SSL3_MD5_MAC
and CKM_SSL3_SHA1_MAC from the list of mechanisms without parameters to
the serializer table, using the CK_MAC_GENERAL_PARAMS serializer.

p11-kit up to 0.25.5 still treats them as having no parameters, so for
these four mechanisms the version 0 and 1 encoding no longer matched
what such peers send and expect:

- A client talking to an old server sent the CK_MAC_GENERAL_PARAMS
  value where the old server reads an empty byte array, so the old
  server parsed the rest of the request from the wrong offset.
- A server serving an old client read the empty byte array the old
  client sends as a CK_MAC_GENERAL_PARAMS value, again misparsing the
  rest of the request (for C_SignInit, the key handle).

This is the failure that protocol version-aware mechanism encoding
fixes for every mechanism, left in place for these four.

The version 0 and 1 encoding now keeps treating them as having no
parameters: the client sends an empty byte array, as old clients do,
and the server decodes what follows the mechanism type as a byte array.
The current encoding is unchanged.

A test checks the byte-exact version 1 encoding of CKM_SHA512_T and that
decoding it leaves the following key handle intact.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Rikard Söderström <Rikard.Soderstrom@permobil.com>
---
 p11-kit/rpc-mechanism.c    | 32 +++++++++++++++++++----
 p11-kit/test-rpc-message.c | 52 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 79 insertions(+), 5 deletions(-)

diff --git a/p11-kit/rpc-mechanism.c b/p11-kit/rpc-mechanism.c
index 6ab6d852..0fa150ce 100644
--- a/p11-kit/rpc-mechanism.c
+++ b/p11-kit/rpc-mechanism.c
@@ -3424,6 +3424,26 @@ p11_rpc_buffer_get_mechanism (p11_buffer *buffer,
 	return true;
 }
 
+/*
+ * p11-kit up to 0.25.5 listed these mechanisms as having no parameters and
+ * so sent, and expected, an empty byte array for them.  They have since
+ * gained parameter serializers, which peers at protocol version 0 or 1 do
+ * not know.
+ */
+static bool
+mechanism_v1_has_no_parameters (CK_MECHANISM_TYPE type)
+{
+	switch (type) {
+	case CKM_SHA512_T:
+	case CKM_SHA512_T_HMAC:
+	case CKM_SSL3_MD5_MAC:
+	case CKM_SSL3_SHA1_MAC:
+		return true;
+	default:
+		return mechanism_has_no_parameters (type);
+	}
+}
+
 /*
  * Mechanism encoding used by RPC protocol versions 0 and 1 (p11-kit up to
  * 0.25.5): no "has parameter" byte, and mechanisms without parameters are
@@ -3439,7 +3459,7 @@ p11_rpc_buffer_add_mechanism_v1 (p11_buffer *buffer, const CK_MECHANISM *mech)
 	/* The mechanism type */
 	p11_rpc_buffer_add_uint32 (buffer, mech->mechanism);
 
-	if (mechanism_has_no_parameters (mech->mechanism)) {
+	if (mechanism_v1_has_no_parameters (mech->mechanism)) {
 		p11_rpc_buffer_add_byte_array (buffer, NULL, 0);
 		return;
 	}
@@ -3485,10 +3505,12 @@ p11_rpc_buffer_get_mechanism_v1 (p11_buffer *buffer,
 		return true;
 	}
 
-	for (i = 0; i < ELEMS (p11_rpc_mechanism_serializers); i++) {
-		if (p11_rpc_mechanism_serializers[i].type == mech->mechanism) {
-			serializer = &p11_rpc_mechanism_serializers[i];
-			break;
+	if (!mechanism_v1_has_no_parameters (mech->mechanism)) {
+		for (i = 0; i < ELEMS (p11_rpc_mechanism_serializers); i++) {
+			if (p11_rpc_mechanism_serializers[i].type == mech->mechanism) {
+				serializer = &p11_rpc_mechanism_serializers[i];
+				break;
+			}
 		}
 	}
 
diff --git a/p11-kit/test-rpc-message.c b/p11-kit/test-rpc-message.c
index 3f7984ab..9495133f 100644
--- a/p11-kit/test-rpc-message.c
+++ b/p11-kit/test-rpc-message.c
@@ -1599,6 +1599,57 @@ test_mechanism_v1_wire_format (void)
 	p11_rpc_mechanisms_override_supported = mechanisms;
 }
 
+/*
+ * p11-kit up to 0.25.5 sent CKM_SHA512_T, CKM_SHA512_T_HMAC,
+ * CKM_SSL3_MD5_MAC and CKM_SSL3_SHA1_MAC as mechanisms without parameters,
+ * followed by an empty byte array.  Protocol version 0 and 1 encoding must
+ * keep doing so although they now have a parameter serializer.
+ */
+static void
+test_mechanism_v1_formerly_parameterless (void)
+{
+	p11_buffer wire;
+	p11_buffer encoded;
+	CK_MECHANISM_TYPE *mechanisms;
+	CK_MAC_GENERAL_PARAMS length = 32;
+	CK_MECHANISM sha512_t = { CKM_SHA512_T, &length, sizeof (length) };
+	CK_MECHANISM val;
+	uint64_t handle;
+	size_t offset;
+	bool ret;
+
+	mechanisms = p11_rpc_mechanisms_override_supported;
+	p11_rpc_mechanisms_override_supported = NULL;
+
+	/* As sent by an old peer */
+	p11_buffer_init (&wire, 0);
+	p11_rpc_buffer_add_uint32 (&wire, CKM_SHA512_T);
+	p11_rpc_buffer_add_byte_array (&wire, NULL, 0);
+	p11_rpc_buffer_add_uint64 (&wire, 0x12345678);
+	assert (!p11_buffer_failed (&wire));
+
+	p11_buffer_init (&encoded, 0);
+	p11_rpc_buffer_add_mechanism_v1 (&encoded, &sha512_t);
+	p11_rpc_buffer_add_uint64 (&encoded, 0x12345678);
+	assert_num_eq (wire.len, encoded.len);
+	assert (memcmp (wire.data, encoded.data, wire.len) == 0);
+	p11_buffer_uninit (&encoded);
+
+	offset = 0;
+	memset (&val, 0, sizeof (val));
+	ret = p11_rpc_buffer_get_mechanism_v1 (&wire, &offset, &val);
+	assert_num_eq (true, ret);
+	assert_num_eq (CKM_SHA512_T, val.mechanism);
+	assert_num_eq (0, val.ulParameterLen);
+	ret = p11_rpc_buffer_get_uint64 (&wire, &offset, &handle);
+	assert_num_eq (true, ret);
+	assert_num_eq (0x12345678, handle);
+	assert_num_eq (wire.len, offset);
+	p11_buffer_uninit (&wire);
+
+	p11_rpc_mechanisms_override_supported = mechanisms;
+}
+
 /* Mechanisms taking an optional CK_SIGN_ADDITIONAL_CONTEXT parameter,
  * as defined by PKCS#11 3.2 sections 6.67.5, 6.67.7, 6.68.5 and 6.68.7 */
 static CK_MECHANISM_TYPE sign_additional_context_mechs[] = {
@@ -1839,6 +1890,7 @@ main (int argc,
 	p11_test (test_ibm_btc_derive_mech_param_update, "/rpc-message/ibm-btc-derive-mech-param-update");
 	p11_test (test_ibm_btc_derive_roundtrip, "/rpc-message/ibm-btc-derive-roundtrip");
 	p11_test (test_mechanism_v1_wire_format, "/rpc-message/mechanism-v1-wire-format");
+	p11_test (test_mechanism_v1_formerly_parameterless, "/rpc-message/mechanism-v1-formerly-parameterless");
 	p11_test (test_sign_additional_context_mechanism, "/rpc-message/sign-additional-context-mechanism");
 	p11_test (test_hash_sign_additional_context_mechanism, "/rpc-message/hash-sign-additional-context-mechanism");
 	p11_test (test_message_write, "/rpc-message/message-write");
